# ===== Skill Agent 配置示例 =====
# 使用前请复制此文件为 .env 并填写你的配置：
#   cp .env.example .env
#   （Windows: copy .env.example .env）

# OpenAI 兼容 API 配置
# - 使用 OpenAI: 填写真实 key，base 通常为 https://api.openai.com/v1
# - 使用 Ollama: OPENAI_BASE_URL=http://127.0.0.1:11434，OPENAI_API_KEY 可留空
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 可选：推理与工作区
MAX_REACT_STEPS=10
TEMPERATURE=0.7
MAX_COMPLETION_TOKENS=4096
OBSERVATION_DISPLAY_MAX_LENGTH=2000
WORKSPACE_DIR=workspace
