# 复制为 .env 后填写。不要把填好的 .env 提交到仓库。

# 必填（本地服务如 localhost / 127.0.0.1 可以留空）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 可选
TEMPERATURE=0.7
MAX_COMPLETION_TOKENS=4096
MAX_REACT_STEPS=10
OBSERVATION_DISPLAY_MAX_LENGTH=2000
HISTORY_MAX_CHARS=24000
WORKSPACE_DIR=workspace
