# ===== Skill Agent 配置示例 =====
# 使用前请复制此文件为 .env 并填写你的配置：
#   cp .env.example .env
#   （Windows: copy .env.example .env）

# OpenAI API 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 可选：推理与工作区
MAX_REACT_STEPS=10
TEMPERATURE=0.7
WORKSPACE_DIR=workspace
